generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Pasajeros que reservan plaza en el manifiesto de vuelo de ORBITAL.
model Passenger {
  id          String   @id @default(cuid())
  email       String   @unique
  callsign    String
  destination String
  seat        Int      @unique
  createdAt   DateTime @default(now())
}
